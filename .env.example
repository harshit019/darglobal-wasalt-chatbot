# Required: Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Default free model (openrouter/free automatically routes to active free models)
OPENROUTER_MODEL=openrouter/free

# Optional: Server settings (Hugging Face Spaces uses port 7860)
PORT=7860
HOST=0.0.0.0

# Optional: Public URL sent as HTTP-Referer to OpenRouter
APP_PUBLIC_URL=https://huggingface.co/spaces
